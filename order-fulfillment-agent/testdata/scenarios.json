    {"name": "out of stock -> hold",  "customer": "cust-007", "items": [{"sku": "SKU-OOS", "quantity": 1}],         "expected_status": "on_hold"},
    {"name": "multi-line partial OOS","customer": "cust-005", "items": [{"sku": "SKU-A", "quantity": 1}, {"sku": "SKU-OOS", "quantity": 3}], "expected_status": "on_hold"}
  ]
